    {
      "id": "90b4e3a7-ad5f-4b41-ac76-5d2a7dbb5e28",
      "position": [
        1300,
        360
      ],
      "name": "추천 응답 구성",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const result = $input.first()?.json ?? {};\n\nif (result.success === true && Array.isArray(result.recommendations)) {\n  return [{ json: result }];\n}\n\nreturn [{ json: {\n  success: false,\n  error_code: 'RECOMMEND_FAILED',\n  message: result.error\n    ? 'F03 실행 중 오류: ' + String(result.error.message ?? result.error)\n    : 'F03 맞춤 상품 추천이 결과를 반환하지 않았습니다.',\n} }];"
      }
    },
