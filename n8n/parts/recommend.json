      "name": "안내: 추천",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -520,
        320
      ],
      "parameters": {
        "content": "## POST /webhook/web/recommend\n요청: `{ customer_id }`\n\n고객과 최신 분석을 조회해 F03에 넘긴다. 분석이 아직 없으면 빈 분석으로 추천한다.\n\n응답: F03 반환값 그대로 (`recommendations[]`, `information_status`, `missing_information[]`)",
        "height": 200,
        "width": 460
      }
    },
    {
      "id": "8580a8bd-d760-423a-a1cc-c3f358acef5f",
      "position": [
        0,
        360
      ],
      "name": "추천 Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "64499898-d688-4ad7-a927-5d5f6640779c",
      "credentials": {
        "httpHeaderAuth": {
          "id": "8QrcxiVCBX9yQfnT",
          "name": "local연동용"
        }
      },
      "parameters": {
        "httpMethod": "POST",
        "path": "web/recommend",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "0e61f188-623e-4712-a50e-f09850be74f1",
      "position": [
        260,
        360
      ],
      "name": "추천: 고객·최신 분석 조회",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "YVkzsBzhXmXxNLug",
          "name": "KT_Project_Supabase_Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    row_to_json(c) AS customer,\n    a.analysis_id,\n    a.analysis_data,\n    row_to_json(co) AS consultation\nFROM public.customers c\nLEFT JOIN LATERAL (\n    SELECT analysis_id, analysis_data\n    FROM public.customer_analyses\n    WHERE customer_id = c.customer_id\n    ORDER BY created_at DESC\n    LIMIT 1\n) a ON TRUE\nLEFT JOIN LATERAL (\n    SELECT *\n    FROM public.consultations\n    WHERE customer_id = c.customer_id\n    ORDER BY consulted_at DESC\n    LIMIT 1\n) co ON TRUE\nWHERE c.customer_id = $1\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.body.customer_id ] }}"
        }
      }
    },
    {
      "id": "f1447ba0-dcd0-44de-a6af-6f4d1f97fa50",
      "position": [
        520,
        360
      ],
      "name": "추천: 고객 있음?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "3cf21008-4a80-483e-aea2-df7a7c5979fc",
              "leftValue": "={{ Boolean($json.customer) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "57a6bc74-6340-42f2-ac6c-afe13c98cf66",
      "position": [
        780,
        360
      ],
      "name": "추천 입력 구성",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const row = $('추천: 고객·최신 분석 조회').first().json;\n\nlet analysis = row.analysis_data ?? {};\nif (typeof analysis === 'string') {\n  try { analysis = JSON.parse(analysis); } catch (error) { analysis = {}; }\n}\n\nreturn [{ json: {\n  customer_id: row.customer.customer_id,\n  analysis_id: row.analysis_id ?? '',\n  analysis,\n  customer: row.customer,\n  consultation: row.consultation ?? {},\n  recommendation_request: '기기·요금제 추천',\n} }];"
      }
    },
