        -272,
        -384
      ],
      "typeVersion": 1,
      "id": "3ad01a49-946c-4c3d-ab58-163fcee9034f",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "content": "## message_data 예시\n{\n  \"customer_id\": \"C001\",\n  \"schedule_type\": \"contract\",\n  \"schedule_subtype\": null,\n  \"contact_reason\": \"약정 만료 1개월 전 안내\",\n\n  \"customer_name\": \"김만용\",\n  \"phone\": \"01012345678\",\n\n  \"current_device\": \"Galaxy S24\",\n  \"current_plan\": \"5G 요금제\",\n  \"usage_pattern\": \"데이터 사용량 많음\",\n  \"contract_end_date\": \"2026-10-26\",\n  \"device_use_months\": 24,\n  \"preferred_brand\": \"Samsung\",\n  \"target_monthly_budget\": 70000,\n  \"interests\": \"기기 변경\",\n\n  \"consultation_summary\": null,\n  \"document_id\": null\n}",
        "height": 560,
        "width": 384
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -448,
        32
      ],
