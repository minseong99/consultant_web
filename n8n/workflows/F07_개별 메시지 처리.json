    },
    {
      "parameters": {
        "content": "[역할]\nS02에서 반환된 generation_success를 확인하여 정상적으로 생성된 메시지만 발송 단계로 전달한다.\n[처리 기준]\n생성 성공 시 문자 발송 단계로 진행하고, 생성 실패 시 해당 스케줄을 실패 상태로 처리한다.",
        "height": 240
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1136,
        -496
      ],
      "id": "5adc25c8-9725-4837-9d8d-61606fa6610b",
      "name": "Sticky Note5"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH inserted AS (\n    INSERT INTO public.messages (\n        message_id,\n        schedule_id,\n        message_content,\n        send_status,\n        sent_at,\n        send_channel\n    )\n    VALUES (\n        'MSG-' || $1,\n        $1,\n        $2,\n        'pending',\n        NULL,\n        'sms'\n    )\n    ON CONFLICT (schedule_id) DO NOTHING\n    RETURNING\n        message_id,\n        schedule_id,\n        message_content,\n        send_status\n)\n\nSELECT\n    message_id,\n    schedule_id,\n    message_content,\n    send_status,\n    TRUE AS newly_created\nFROM inserted\n\nUNION ALL\n\nSELECT\n    m.message_id,\n    m.schedule_id,\n    m.message_content,\n    m.send_status,\n    FALSE AS newly_created\nFROM public.messages m\nWHERE m.schedule_id = $1\n  AND NOT EXISTS (SELECT 1 FROM inserted)\n\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [   $json.schedule_id,   $json.message_text ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1552,
        -352
      ],
      "id": "e4d32d0e-d47c-4b43-8abb-f5cf55c1a075",
      "name": "[저장] 생성 메시지 적재",
      "credentials": {
        "postgres": {
          "id": "YVkzsBzhXmXxNLug",
