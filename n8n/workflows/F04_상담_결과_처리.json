    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst result = input.consultation_result ?? {};\n\nreturn [\n  {\n    json: {\n      customer_id: input.customer_id ?? null,\n      consultation_id: input.consultation_id ?? null,\n      staff_id: input.staff_id ?? null,\n      analysis_id: input.analysis_id ?? null,\n      recording_url: input.recording_url ?? null,\n\n      consultation_result: {\n        notes: result.notes ?? '',\n        customer_response: result.customer_response ?? null,\n\n        selected_product: result.selected_product ?? null,\n        selected_plan: result.selected_plan ?? null,\n\n        follow_up_requested:\n          typeof result.follow_up_requested === 'boolean'\n            ? result.follow_up_requested\n            : null,\n\n        preferred_follow_up_date:\n          result.preferred_follow_up_date ?? null\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -656,
