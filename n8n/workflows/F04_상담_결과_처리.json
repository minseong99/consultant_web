      ],
      "id": "b3ee9bce-71ec-4a28-a8d5-f89d2bb75284",
      "name": "F05 입력 데이터 정리"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"customer_id\": {\n      \"type\": \"string\"\n    },\n    \"consultation_id\": {\n      \"type\": \"string\"\n    },\n    \"analysis_id\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"consultation_summary\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"result_status\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"completed\",\n        \"pending\",\n        \"rejected\",\n        \"follow_up\"\n      ]\n    },\n    \"customer_response\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"interested_product\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"interested_plan\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"special_notes\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"follow_up_required\": {\n      \"type\": \"boolean\"\n    },\n    \"follow_up_reason\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"schedule_type\": {\n      \"type\": [\"string\", \"null\"],\n      \"enum\": [\n        \"reconsultation\",\n        \"contract_expiry\",\n        \"other\",\n        null\n      ]\n    },\n    \"preferred_follow_up_date\": {\n      \"type\": [\"string\", \"null\"]\n    }\n  },\n  \"required\": [\n    \"customer_id\",\n    \"consultation_id\",\n    \"analysis_id\",\n    \"consultation_summary\",\n    \"result_status\",\n    \"customer_response\",\n    \"interested_product\",\n    \"interested_plan\",\n    \"special_notes\",\n    \"follow_up_required\",\n    \"follow_up_reason\",\n    \"schedule_type\",\n    \"preferred_follow_up_date\"\n  ],\n  \"additionalProperties\": false\n}"
      },
