      "parameters": {
        "jsCode": "const base = $('F05 입력 데이터 정리').first().json;\n\nconst transcript =\n  $json.text ??\n  $json.transcript ??\n  $json.data?.text ??\n  null;\n\nreturn [\n  {\n    json: {\n      ...base,\n      transcription_text: transcript\n    }\n  }\n];"
