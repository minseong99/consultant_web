# true면 n8n·Supabase 없이 내장 샘플 데이터로 동작합니다 (로컬 전용).
USE_MOCK=true

# ---- 아래는 USE_MOCK=false 일 때 필요합니다. 모두 서버 전용 값입니다. ----

# n8n 게이트웨이 webhook 기본 주소 (테스트 URL을 쓰려면 /webhook-test)
N8N_BASE_URL=https://gotu4545.app.n8n.cloud/webhook
# 게이트웨이 Webhook 노드의 Header Auth(x-web-secret) 값과 같아야 합니다.
N8N_WEB_SECRET=

SUPABASE_URL=https://rwvysldcynfvlqqqjjoz.supabase.co
# Supabase 대시보드 > Project Settings > API > service_role. 절대 커밋하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 직원 로그인 공용 비밀번호
STAFF_DEMO_PASSWORD=
# 세션 쿠키 서명용 임의 문자열 (예: openssl rand -hex 32)
SESSION_SECRET=
